# ==============================================================================
# PERSONAL GEMINI JOURNAL - ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Instructions:
# 1. For Local Development:
#    - Copy this file to '.env': `cp .env.example .env`
#    - Fill in your actual Firebase and Gemini API keys below.
#
# 2. For Production / Google Cloud Run:
#    - Store sensitive secrets (GEMINI_API_KEY, FIREBASE_SERVICE_ACCOUNT_KEY)
#      in Google Cloud Secret Manager.
#    - Mount them as environment variables in Cloud Run via:
#      gcloud run services update personal-gemini-journal \
#        --set-secrets="GEMINI_API_KEY=projects/PROJECT_ID/secrets/gemini-api-key:latest"
#    - Non-sensitive public client variables (VITE_FIREBASE_*) can be set directly
#      as standard Cloud Run environment variables or bundled at build time.
# ==============================================================================

# --- [BACKEND SECRETS] (Store in Google Cloud Secret Manager in Production) ---

# GEMINI_API_KEY:
# Required for Gemini AI multi-turn chat and journal summarization.
# Obtain from Google AI Studio (https://aistudio.google.com/app/apikey).
# In production, back this with Google Cloud Secret Manager!
GEMINI_API_KEY="your-gemini-api-key-here"

# FIREBASE_PROJECT_ID:
# Your Firebase/Google Cloud Project ID (e.g., "my-journal-app-12345").
FIREBASE_PROJECT_ID="your-firebase-project-id"

# FIREBASE_SERVICE_ACCOUNT_KEY (Optional for local dev / Cloud Run with IAM):
# When deploying to Cloud Run, Firebase Admin automatically uses Cloud Run's
# Application Default Credentials (ADC) if the service account has "Firebase Authentication Admin".
# If testing locally, you can paste the minified JSON of your service account key here:
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"..."}'

# PORT: Port for the backend Express server (Cloud Run injects PORT=3000 automatically).
PORT=3000

# APP_URL: Host URL for self-referential links / CORS
APP_URL="http://localhost:3000"

# --- [CLIENT-SIDE CONFIGURATION] (Public Vite Variables) ---
# Obtain these values from Firebase Console:
# Project Settings > General > "Your apps" > Web App config object.

VITE_FIREBASE_API_KEY="AIzaSyYourFirebaseWebApiKeyHere"
VITE_FIREBASE_AUTH_DOMAIN="your-firebase-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-firebase-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-firebase-project-id.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"
