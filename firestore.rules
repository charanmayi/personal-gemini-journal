rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // GLOBAL DEFAULT DENY CATCH-ALL
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // REUSABLE HARDENED PRIMITIVES & VALIDATORS
    // =========================================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validates a JournalEntry document against schema boundaries
    function isValidJournalEntry(data, userId) {
      return data.userId is string &&
        data.userId == userId &&
        data.userId == request.auth.uid &&
        data.title is string &&
        data.title.size() > 0 &&
        data.title.size() <= 150 &&
        data.summary is string &&
        data.summary.size() > 0 &&
        data.summary.size() <= 5000 &&
        (!('mood' in data) || (data.mood is string && data.mood.size() <= 50)) &&
        (!('tags' in data) || (data.tags is list && data.tags.size() <= 20)) &&
        (!('insights' in data) || (data.insights is list && data.insights.size() <= 20)) &&
        (!('messageCount' in data) || data.messageCount is number);
    }

    // Validates a basic UserProfile document
    function isValidUserProfile(data, userId) {
      return data.email is string &&
        data.email.size() <= 255 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120));
    }

    // =========================================================================
    // USER DOCUMENTS & ISOLATED PRIVATE SUBCOLLECTIONS
    // =========================================================================
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(incoming(), userId) && incoming().createdAt == request.time;
      allow update: if isOwner(userId) && isValidUserProfile(incoming(), userId) && incoming().createdAt == existing().createdAt;
      allow delete: if isOwner(userId);

      // Private journal entries strictly isolated by userId
      match /journals/{journalId} {
        allow get: if isValidId(journalId) && isOwner(userId);
        allow list: if isOwner(userId);
        
        allow create: if isValidId(journalId) &&
          isOwner(userId) &&
          isValidJournalEntry(incoming(), userId) &&
          incoming().createdAt == request.time;

        allow update: if isValidId(journalId) &&
          isOwner(userId) &&
          isValidJournalEntry(incoming(), userId) &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time;

        allow delete: if isValidId(journalId) && isOwner(userId);
      }
    }
  }
}
